{#
  P0 - Draft of sa_textupd / sa_build for P3 / P4. Written by
  playbooks/00_discover.yml to sa_policy/output/discover_<stamp>/batch_draft.yml.
  The candidate lines from the spike are copied in as comments.
#}
---
# =============================================================================
# Batch mechanism for P3 (text-file update) and P4 (build) - DRAFT
# Generated by 00_discover.yml on {{ r.stamp }} ({{ r.system }}).
#
#   1. Fill sa_textupd.systsin / dd and sa_build.systsin / dd from the
#      commented candidates below (full members: spike_full.txt).
#   2. Point every PDB reference at the CLONE:
#        data set : {{ r.clone_dsn }}
#        name     : {{ r.clone_pdb_name }}
#      and the build output at {{ r.staging_dsn }}.
#      The JCL guard rejects any production name.
#   3. Set verified: true on each, then run
#        ansible-playbook ... 30_apply_to_pdb.yml -e @{{ r.dir_shown }}/batch_draft.yml
#
# Passed with -e @file, these dictionaries replace the ones in
# vars/sa_env.yml completely, so keep every key.
# =============================================================================

sa_textupd:
  verified: false
  max_rc: 0
  dd:
    - name: TEXTIN
      spec: "DISP=SHR,DSN={% raw %}{{ sa_work_pds }}({{ sa_new_policy.textfile_member }}){% endraw %}"
  systsin: []
{% if r.spike_textupd %}
  # Candidates from the spike:
{%   for m in r.spike_textupd %}
  #
  # --- {{ m.member }}{{ ' - ' ~ m.title if m.title else '' }}
  #     DDs: {{ m.dds | join(', ') or '-' }}
{%     for l in (m.systsin or m.ispstart) %}
  #   - "{{ l | replace('"', '\\"') }}"
{%     endfor %}
{%   endfor %}
{% else %}
  # No candidate found in the spike libraries; see report.txt.
{% endif %}

sa_build:
  verified: false
  max_rc: 0
  type: MOD
  dd: []
  systsin: []
{% if r.spike_build %}
{%   set m = r.spike_build[0] %}
  # From {{ m.member }}{{ ' - ' ~ m.title if m.title else '' }}
  #     DDs: {{ m.dds | join(', ') or '-' }}
{%   for l in (m.systsin or m.ispstart) %}
  #   - "{{ l | replace('"', '\\"') }}"
{%   else %}
  #   (no SYSTSIN or ISPSTART line; read the member in spike_full.txt)
{%   endfor %}
  # Variables you can use: {% raw %}{{ sa_clone_pdb_name }}, {{ sa_clone_dsn }},
  # {{ sa_staging_dsn }}, {{ sa_build_type_effective }}, {{ sa_sysplex }}{% endraw %}

{% else %}
  # INGEBBLD was not found; take the step from the site build job.
{% endif %}
